# Copy to .env (local dev). All variables are validated in src/server/env.ts.

# Postgres from `pnpm db:up` (docker-compose.yml, host port 5452 by default).
# The app connects as the RLS-restricted role (ADR-020); migrations and the
# seed use the owner (DATABASE_URL_ADMIN). `pnpm db:app-role` sets the dev password.
DATABASE_URL="postgresql://depmap_app:depmap_app_dev@localhost:5452/depmap"
DATABASE_URL_ADMIN="postgresql://depmap:depmap@localhost:5452/depmap"

# Integration tests only (database created by docker/postgres/init)
DATABASE_URL_TEST="postgresql://depmap:depmap@localhost:5452/depmap_test"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
# Public base URL of the app. Must be https:// in production.
BETTER_AUTH_URL="http://localhost:3000"

# ── Optional ────────────────────────────────────────────────────────────────
# Integrations with stored read-only tokens (ADR-018 D). 32 bytes, base64:
#   openssl rand -base64 32
# To rotate: move the current key to _PREVIOUS, set a new key, bump the version.
CREDENTIALS_ENCRYPTION_KEY=""
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=""
CREDENTIALS_KEY_VERSION="1"
# Bearer secret for /api/cron/* (scheduled integration sync). >= 32 chars.
CRON_SECRET=""
# M27: private networks local-source integrations (Proxmox, TrueNAS, Synology) may reach.
INTEGRATIONS_PRIVATE_NETWORKS=""
# "true" only when running behind your own reverse proxy (docs/DEPLOYMENT.md).
TRUST_PROXY="false"
# Outgoing email, e.g. smtps://user:pass@smtp.example.com:465 (MAIL_FROM required).
# Set = email verification is REQUIRED to sign in and to accept invitations.
# Unset = emails are printed to the server log (development only; dropped in production).
SMTP_URL=""
MAIL_FROM=""
# In-app feedback recipient (needs SMTP). Unset = no feedback button.
FEEDBACK_EMAIL=""
# M13: SIGNUP=open|closed (invite-only), PUBLIC_SITE / DEMO_MODE = InfraMole's own website and demo.
SIGNUP="open"
PUBLIC_SITE="false"
DEMO_MODE="false"
# Base URL of the signed agent releases (download links + verified install commands),
# e.g. https://github.com/<owner>/<repo>/releases/latest/download
AGENT_DOWNLOAD_BASE_URL=""
# SSO sign-in (optional; each provider needs both values). Redirect URI to register:
#   <BETTER_AUTH_URL>/api/auth/callback/google  and  …/callback/microsoft
# Edition (ADR-019): community (default, 25 servers/VMs per instance) · cloud · business
EDITION="community"
# Business edition licence (scripts/licence.mjs issue …)
DEPMAP_LICENSE_KEY=""
# Cloud billing (EDITION=cloud only). Webhook: <BETTER_AUTH_URL>/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_SCALE=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" (any Microsoft account), "organizations" (work/school only) or a tenant id
MICROSOFT_TENANT_ID=""
