# InfraMole configuration — copy to .env (never commit or share it) and fill in.
# Fill the secrets:  ./scripts/gen-secrets.sh .env   (Windows: scriptsgen-secrets.ps1)
# Reference: https://inframole.com/docs/reference/environment

# Public hostname (DNS A/AAAA record must point to this server).
DEPMAP_DOMAIN=inframole.example.com
# Optional: extra hostnames that 301-redirect to DEPMAP_DOMAIN (space-separated),
# e.g. www.inframole.example.com. Each needs a DNS record pointing here.
# DEPMAP_REDIRECT_HOSTS=
# Optional: "tls internal" = Caddy's own CA (local trial only). Empty = Let's Encrypt.
CADDY_TLS=
# Optional host ports (defaults 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443

# Edition: community (free & open source, AGPL-3.0: unlimited servers/VMs, 1 workspace) · business
# (licence below) · cloud (InfraMole's hosted service only).
EDITION=community
# DEPMAP_LICENSE_KEY=dml1.…

# ── Secrets (gen-secrets.sh) ──────────────────────────────────────────────────
POSTGRES_PASSWORD=
# Runtime role depmap_app (Row Level Security applies to it; ADR-020).
APP_DB_PASSWORD=
BETTER_AUTH_SECRET=
# Enables Settings › Integrations (encrypted read-only cloud credentials).
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_KEY_VERSION=1
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=   # only while rotating (DEPLOYMENT.md)
# Enables the scheduled integration sync (cron service).
CRON_SECRET=

# ── Email (verification, password reset, invitations) ─────────────────────────
# Set = email verification is required. Unset = emails are dropped (warning in logs).
SMTP_URL=
MAIL_FROM=
# In-app feedback is emailed here (needs SMTP). Unset = no feedback button.
FEEDBACK_EMAIL=

# ── Agent downloads ───────────────────────────────────────────────────────────
# Signed agent releases; the enrollment dialog then shows download + verify
# commands. e.g. https://github.com/InfraMole/agent/releases/latest/download
AGENT_DOWNLOAD_BASE_URL=

# ── SSO (optional) ────────────────────────────────────────────────────────────
# Redirect URIs: https://$DEPMAP_DOMAIN/api/auth/callback/google | …/microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# organizations = work/school accounts only (recommended for B2B)
MICROSOFT_TENANT_ID=organizations

# ── Backups ───────────────────────────────────────────────────────────────────
# age public key (age1…). Keep the private key OFF the server. Unset = unencrypted.
BACKUP_AGE_RECIPIENT=

# ── Operations ────────────────────────────────────────────────────────────────
CRON_EVERY_SECONDS=900
BACKUP_KEEP_DAYS=14
